#!/usr/bin/env python3
"""Set the RGB color of a LEOBOG Hi75C (Pro) keyboard (2.4 GHz dongle or USB cable)
and of a MCHOSE MagDock mouse charging dock on Linux. Every command targets all
connected devices; the dock protocol is documented next to send_dock().

2.4 GHz dongle 3554:FA09, HID interface with vendor usage page 0xFF02, 20-byte output reports:
  [0]=0x13 report id, [1]=command, [2]=packet count, [3]=sequence, [4]=mode/len,
  [5..18]=data, [19]=checksum (low byte of sum of bytes 0..18).
  0x88 live solid fill (expires after ~1 s, needs re-sending):
       13 88 01 00 23 R G B ...
       (from https://github.com/x0sman/better-hi75c-pro-driver, docs/PROTOCOL.md)
  0x02 full profile for "self-define" mode (found by testing, kept until keyboard power off):
       378 bytes planar R[126] G[126] B[126], LED index = 8 + col*6 + row,
       sent as 27 reports 13 02 1b <seq> 0e <14 data bytes> <checksum>

USB cable (wired mode) 258A:010C, interface 1, one 520-byte feature report:
  [0]=0x06 [1]=0x08 [6]=0x7a [7]=0x01, then R,G,B per LED slot from byte 8 (170 slots)
  Live only (reverts after ~1 s), so it must be re-sent: see hold.
  (from https://github.com/pzwt4cc/LEOBOG-GUI-HI75C)

Usage:
  leobog-rgb save '#ff8800'         set the color once (dongle: profile write; cable: feature report)
  leobog-rgb save                   re-send the last color (run at login)
  leobog-rgb set '#ff8800'          dongle: live color only (reverts after ~1 s)
  leobog-rgb hold                   daemon: cable -> re-send every 0.7 s, dongle -> only on change
  leobog-rgb wallpaper IMAGE        pick a dominant vivid color from an image
  leobog-rgb brightness 30          brightness in percent (also +10 / -10), re-applies the color
  leobog-rgb config dock_blue 0.7   other settings: see DEFAULTS (file ~/.config/leobog-rgb/config)
  leobog-rgb test ffffff            show a color without storing it (calibration), undo: save
  leobog-rgb theme                  apply the current Noctalia primary color
  leobog-rgb off
  leobog-rgb find                   show which device and mode is used
Colors are converted per device (saturation, gamma, white balance, brightness); --raw sends them unchanged.
"""

import argparse
import colorsys
import fcntl
import glob
import os
import select
import sys
import time

DONGLE = (0x3554, 0xFA09)
WIRED = (0x258A, 0x010C)
STATE_FILE = os.path.expanduser("~/.cache/leobog-rgb/last")
TEST_FILE = os.path.expanduser("~/.cache/leobog-rgb/test")  # temporary override from `test`

N_LEDS = 126  # dongle profile: 21 columns x 6 rows
CHUNK = 14
WIRED_PAYLOAD = 520
WIRED_SLOTS = 170


def find_device():
    """Return (path, kind) of the RGB hidraw node; kind is 'wired' or 'dongle'.

    Wired wins: when the cable is in wired mode, the keyboard does not listen to the dongle.
    """
    found = {}
    for node in sorted(glob.glob("/sys/class/hidraw/hidraw*")):
        try:
            with open(os.path.join(node, "device/uevent")) as f:
                uevent = f.read().upper()
            path = "/dev/" + os.path.basename(node)
            if "%08X:%08X" % WIRED in uevent:
                dev_dir = os.path.realpath(os.path.join(node, "device"))
                with open(os.path.join(dev_dir, "..", "bInterfaceNumber")) as f:
                    if int(f.read().strip(), 16) == 1:
                        found.setdefault("wired", path)
            elif "%08X:%08X" % DONGLE in uevent:
                with open(os.path.join(node, "device/report_descriptor"), "rb") as f:
                    # Vendor-defined usage page 0xFF02 is the configuration channel
                    if f.read().startswith(b"\x06\x02\xff"):
                        found.setdefault("dongle", path)
        except (OSError, ValueError):
            continue
    for kind in ("wired", "dongle"):
        if kind in found:
            return found[kind], kind
    return None, None


# --- 2.4 GHz dongle -------------------------------------------------------

def checksum(rep):
    rep[19] = sum(rep[:19]) & 0xFF
    return bytes(rep)


def build_live(r, g, b):
    rep = bytearray(20)
    rep[0:5] = b"\x13\x88\x01\x00\x23"
    rep[5:8] = bytes((r, g, b))
    return checksum(rep)


def build_profile(r, g, b):
    data = bytes([r]) * N_LEDS + bytes([g]) * N_LEDS + bytes([b]) * N_LEDS
    count = len(data) // CHUNK
    reports = []
    for seq in range(count):
        rep = bytearray(20)
        rep[0:5] = bytes((0x13, 0x02, count, seq, CHUNK))
        rep[5:19] = data[seq * CHUNK:(seq + 1) * CHUNK]
        reports.append(checksum(rep))
    return reports


def write_reports(path, reports, delay=0.0):
    with open(path, "wb", buffering=0) as f:
        for rep in reports:
            f.write(rep)
            if delay:
                time.sleep(delay)


# --- USB cable (wired mode) -----------------------------------------------

def build_wired(r, g, b):
    payload = bytearray(WIRED_PAYLOAD)
    payload[0], payload[1], payload[6], payload[7] = 0x06, 0x08, 0x7A, 0x01
    for slot in range(WIRED_SLOTS):
        i = 8 + slot * 3
        if i + 2 >= WIRED_PAYLOAD:
            break
        payload[i:i + 3] = bytes((r, g, b))
    return bytes(payload)


def send_wired(path, r, g, b):
    payload = build_wired(r, g, b)
    # HIDIOCSFEATURE(len) = _IOC(_IOC_READ|_IOC_WRITE, 'H', 0x06, len)
    req = (3 << 30) | (len(payload) << 16) | (ord("H") << 8) | 0x06
    fd = os.open(path, os.O_RDWR)
    try:
        fcntl.ioctl(fd, req, payload)
    finally:
        os.close(fd)


# --- MCHOSE MagDock (mouse charging dock) ---------------------------------
# Protocol from the official MCHOSE M HUB web driver (base-dock-rgb):
#   64-byte reports, no report id: aa <cmd> <type 0=request> 00 00 <param len> <params...>
#   cmd 7  read global info -> params: switch, mode, modeNum, speed, brightness(0-4),
#          sync, R, G, B, ... ; response type 2
#   cmd 39 set global info  <- switch, mode, modeNum, speed, brightness, sync, R, G, B, direction
#   modes: 0 static, 1 breath, 2 shining, 3 color cycle, 4 flow, 5 music/sync
#   (never use cmd 42 factory reset, 43/116 firmware update)
# The dock stores the setting itself, no re-sending needed.

DOCK = (0x3837, 0x1012)
# Brightness on the dock is done with its 5 hardware levels (0-4), not by scaling the
# color: at low values (~5-20 of 255) the red LED barely lights and everything turns blue.


def find_dock():
    for node in sorted(glob.glob("/sys/class/hidraw/hidraw*")):
        try:
            with open(os.path.join(node, "device/uevent")) as f:
                if "%08X:%08X" % DOCK not in f.read().upper():
                    continue
            with open(os.path.join(node, "device/report_descriptor"), "rb") as f:
                if f.read().startswith(b"\x06\x00\xff"):  # vendor usage page 0xFF00
                    return "/dev/" + os.path.basename(node)
        except OSError:
            continue
    return None


def dock_xfer(fd, cmd, params=(), wait=1.0):
    """Send a dock command and return the matching response (or None)."""
    report = bytes([0xAA, cmd, 0, 0, 0, len(params), *params]).ljust(64, b"\0")
    os.write(fd, b"\0" + report)  # leading 0 = report id, stripped by hidraw
    end = time.time() + wait
    while time.time() < end:
        ready, _, _ = select.select([fd], [], [], 0.05)
        if ready:
            data = os.read(fd, 64)
            if data[:2] == bytes((0xAA, cmd)):
                return data
    return None


def dock_level(brightness):
    """Map brightness percent to the dock's hardware level 0-4 (None = off)."""
    if brightness <= 0:
        return None
    return min(4, int(brightness // 20))  # 1-19% -> 0, 20-39% -> 1, ... 80-100% -> 4


def send_dock(path, r, g, b, level=4):
    """Static color; keep the dock's other settings (speed, modeNum, direction)."""
    fd = os.open(path, os.O_RDWR | os.O_NONBLOCK)
    try:
        info = dock_xfer(fd, 7)
        mode_num, speed, direction = 5, 2, 0  # defaults used by the official driver
        if info:
            p = info[6:]
            mode_num, speed, direction = p[2], p[3], p[29]
        on = 1 if (r, g, b) != (0, 0, 0) and level is not None else 0
        dock_xfer(fd, 39, (on, 0, mode_num, speed, level or 0, 0, r, g, b, direction), wait=0.3)
    finally:
        os.close(fd)


# --- common ---------------------------------------------------------------

def apply(path, kind, rgb, persistent):
    """Send to one device. kind: 'wired' / 'dongle' (keyboard) or 'dock'."""
    # Serialize senders (hold daemon, hotkeys, Noctalia hook): interleaved
    # multi-report profile writes would corrupt each other.
    lock_path = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "leobog-rgb.lock")
    with open(lock_path, "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if kind == "dock":
            send_dock(path, *rgb[:3], level=rgb[3] if len(rgb) > 3 else 4)
        elif kind == "wired":
            send_wired(path, *rgb)
        elif persistent:
            write_reports(path, build_profile(*rgb), delay=0.02)
        else:
            write_reports(path, [build_live(*rgb)])


def find_all():
    """All connected RGB devices as [(path, kind)]: keyboard first, then the dock."""
    devices = []
    path, kind = find_device()
    if path:
        devices.append((path, kind))
    dock = find_dock()
    if dock:
        devices.append((dock, "dock"))
    return devices


def parse_hex(s):
    s = s.strip().lstrip("#")
    if len(s) == 3:
        s = "".join(c * 2 for c in s)
    if len(s) != 6:
        raise ValueError(f"invalid color: {s!r}")
    return tuple(int(s[i:i + 2], 16) for i in (0, 2, 4))


# Color tuning, kept in dotfiles (stowed). Brightness changes all the time (hotkeys),
# so it lives in a separate state file outside the repo.
CONFIG_FILE = os.path.expanduser("~/.config/leobog-rgb/config")
BRIGHTNESS_FILE = os.path.join(
    os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state")), "leobog-rgb", "brightness")
DEFAULTS = {
    "brightness": 50.0,  # percent, applied in software (the devices show raw RGB values)
    "saturation": 0.5,   # multiplier, >1 makes colors stronger, <1 softer
    # Per device. gamma: LEDs are linear, screen colors are sRGB, without it colors look
    # whitish. red/green/blue: white balance gains, blue LEDs are the strongest so colors
    # drift towards blue/purple. Calibrate with `leobog-rgb test ffffff`.
    "keyboard_saturation": 1.0,  # per device, multiplied with saturation
    "keyboard_gamma": 2.2,
    "keyboard_red": 1.0,
    "keyboard_green": 0.9,
    "keyboard_blue": 0.75,
    "dock_saturation": 0.7,  # muted, a subtle accent
    "dock_gamma": 1.8,
    "dock_red": 1.0,
    "dock_green": 0.9,
    "dock_blue": 0.65,
}


def load_config():
    cfg = dict(DEFAULTS)
    try:
        with open(CONFIG_FILE) as f:
            for line in f:
                key, sep, value = line.partition("=")
                key = key.strip()
                if sep and key in cfg and key != "brightness":
                    try:
                        cfg[key] = float(value.split("#")[0])
                    except ValueError:
                        pass
    except OSError:
        pass
    try:
        with open(BRIGHTNESS_FILE) as f:
            cfg["brightness"] = float(f.read())
    except (OSError, ValueError):
        pass
    return cfg


def save_setting(key, value):
    """Store one setting. Brightness goes to the state file; anything else is updated
    in place in CONFIG_FILE (other lines and comments are kept; symlinks are followed,
    so a stowed config is edited in the dotfiles repo)."""
    if key == "brightness":
        os.makedirs(os.path.dirname(BRIGHTNESS_FILE), exist_ok=True)
        with open(BRIGHTNESS_FILE, "w") as f:
            f.write(f"{value:g}\n")
        return
    path = os.path.realpath(CONFIG_FILE)
    try:
        with open(path) as f:
            lines = f.readlines()
    except OSError:
        lines = ["# leobog-rgb color tuning, see DEFAULTS in leobog-rgb\n"]
    for i, line in enumerate(lines):
        k, sep, rest = line.partition("=")
        if sep and k.strip() == key:
            comment = rest[rest.index("#"):].rstrip("\n") if "#" in rest else ""
            lines[i] = f"{key} = {value:g}" + (f"  {comment}" if comment else "") + "\n"
            break
    else:
        lines.append(f"{key} = {value:g}\n")
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as f:
        f.writelines(lines)


def to_led(rgb, cfg, kind):
    """Convert a screen (sRGB) color to LED values for one device:
    saturation, gamma, white balance, brightness."""
    if rgb == (0, 0, 0):
        return rgb
    dev = "dock" if kind == "dock" else "keyboard"
    h, s, v = colorsys.rgb_to_hsv(*(c / 255 for c in rgb))
    s = min(1.0, s * cfg["saturation"] * cfg[f"{dev}_saturation"])
    lin = [c ** cfg[f"{dev}_gamma"] for c in colorsys.hsv_to_rgb(h, s, v)]
    gains = [cfg[f"{dev}_{ch}"] for ch in ("red", "green", "blue")]
    brightness = max(0.0, min(100.0, cfg["brightness"]))
    if dev == "dock":
        # full color values + hardware level as a 4th element, see dock_level()
        out = [max(0, min(255, round(c * g * 255))) for c, g in zip(lin, gains)]
        return (*out, dock_level(brightness))
    scale = brightness / 100
    return tuple(max(0, min(255, round(c * g * scale * 255))) for c, g in zip(lin, gains))


def dominant_color(path):
    """Pick the most common reasonably saturated hue bucket in the image."""
    from PIL import Image

    img = Image.open(path).convert("RGB")
    img.thumbnail((160, 160))
    buckets = {}
    for r, g, b in img.getdata():
        h, s, v = colorsys.rgb_to_hsv(r / 255, g / 255, b / 255)
        if s < 0.25 or v < 0.2:
            continue
        key = int(h * 36)  # 10-degree hue buckets
        w = s * v  # favor vivid pixels
        acc = buckets.setdefault(key, [0.0, 0.0, 0.0, 0.0])
        acc[0] += w
        acc[1] += r * w
        acc[2] += g * w
        acc[3] += b * w
    if not buckets:
        return (255, 255, 255)
    total, r, g, b = max(buckets.values(), key=lambda a: a[0])
    return (round(r / total), round(g / total), round(b / total))


def load_state(path=STATE_FILE):
    """Last color ("off" is stored as black and stays black)."""
    try:
        with open(path) as f:
            return parse_hex(f.read())
    except (OSError, ValueError):
        return (255, 255, 255)


def save_state(rgb, path=STATE_FILE):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as f:
        f.write("#%02x%02x%02x\n" % rgb)
    if path == STATE_FILE and os.path.exists(TEST_FILE):
        os.remove(TEST_FILE)  # any real color ends a calibration test


def hold_loop(interval):
    """Keep the color from STATE_FILE on the keyboard, cheaply.

    - cable (wired mode): colors are live only (expire after ~1 s), re-send every tick
    - dongle: write the profile once whenever the color or connection changes, then idle
    Re-reads the state file and the device on every tick, so `leobog-rgb save`
    and dongle/cable switches are followed.
    """
    last = {}
    while True:
        color = load_state(TEST_FILE if os.path.exists(TEST_FILE) else STATE_FILE)
        cfg = load_config()
        seen = {}
        for path, kind in find_all():
            rgb = to_led(color, cfg, kind)
            seen[kind] = (path, rgb)
            try:
                if kind == "wired":
                    apply(path, kind, rgb, persistent=False)
                elif last.get(kind) != (path, rgb):
                    if kind == "dongle":
                        time.sleep(1.0)  # let the keyboard settle after a cable unplug
                    apply(path, kind, rgb, persistent=True)
            except OSError:
                seen.pop(kind, None)  # device busy or gone: retry next tick
        last = seen
        time.sleep(interval)


def main():
    ap = argparse.ArgumentParser(description="LEOBOG Hi75C RGB control")
    sub = ap.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("save", help="set the color once (self-define mode)")
    p.add_argument("color", nargs="?", help="default: last color (restore, e.g. at login)")
    p.add_argument("--raw", action="store_true")
    p = sub.add_parser("set", help="dongle: live color only, reverts after ~1 s")
    p.add_argument("color")
    p.add_argument("--raw", action="store_true")
    p = sub.add_parser("wallpaper")
    p.add_argument("image")
    p.add_argument("--raw", action="store_true")
    p = sub.add_parser("test", help="show a color without storing it (calibration); undo: save")
    p.add_argument("color")
    p.add_argument("--raw", action="store_true")
    sub.add_parser("theme", help="apply the current Noctalia primary color")
    p = sub.add_parser("hold")
    p.add_argument("--interval", type=float, default=0.7)
    p = sub.add_parser("brightness", help="show or set brightness in percent: 30, +10, -10")
    p.add_argument("value", nargs="?")
    p = sub.add_parser("config", help="show or set a setting: config gamma 2.4")
    p.add_argument("key", nargs="?", choices=list(DEFAULTS))
    p.add_argument("value", nargs="?", type=float)
    sub.add_parser("off")
    sub.add_parser("find")
    args = ap.parse_args()

    cfg = load_config()
    if args.cmd in ("brightness", "config"):
        key, value = ("brightness", args.value) if args.cmd == "brightness" else (args.key, args.value)
        if key is None:
            print("\n".join(f"{k} = {v:g}" for k, v in cfg.items()))
            return 0
        if value is None:
            print(f"{key} = {cfg[key]:g}")
            return 0
        value = str(value)
        if args.cmd == "brightness" and value[0] in "+-":
            cfg[key] = max(0.0, min(100.0, cfg[key] + float(value)))
        else:
            cfg[key] = float(value)
        save_setting(key, cfg[key])
        print(f"{key} = {cfg[key]:g}")
        # re-apply the current color (or the calibration test color, keeping the test on)
        if os.path.exists(TEST_FILE):
            args.cmd, args.color = "test", "#%02x%02x%02x" % load_state(TEST_FILE)
        else:
            args.cmd, args.color = "save", None
        args.raw = False

    devices = find_all()
    if args.cmd == "find":
        for path, kind in devices:
            print(f"{path} ({kind})")
        return 0 if devices else 1
    if not devices:
        print("no device found (keyboard 3554:fa09 / 258a:010c, dock 3837:1012)", file=sys.stderr)
        return 1

    # The state file keeps the original (screen) color, conversion happens at send time
    if args.cmd == "off":
        rgb = (0, 0, 0)
    elif args.cmd == "wallpaper":
        rgb = dominant_color(args.image)
    elif args.cmd == "theme":
        with open(os.path.expanduser("~/.cache/leobog-rgb/primary")) as f:
            rgb = parse_hex(f.read())
        args.cmd = "save"
    elif args.cmd in ("hold", "save") and not getattr(args, "color", None):
        rgb = load_state()
    else:
        rgb = parse_hex(args.color)
    raw = getattr(args, "raw", False)

    if args.cmd == "hold":
        try:
            hold_loop(args.interval)
        except KeyboardInterrupt:
            pass
        return 0

    # the hold daemon picks this up on its next tick
    save_state(rgb, TEST_FILE if args.cmd == "test" else STATE_FILE)
    status = 0
    for path, kind in devices:
        if args.cmd == "set" and kind == "dock":
            continue  # "set" is the keyboard live mode only
        led = rgb if raw else to_led(rgb, cfg, kind)
        try:
            apply(path, kind, led, persistent=args.cmd in ("save", "wallpaper", "off", "test"))
            extra = f", level {led[3]}" if len(led) > 3 else ""
            print("#%02x%02x%02x -> LED #%02x%02x%02x%s on %s (%s)" % (*rgb, *led[:3], extra, path, kind))
        except PermissionError:
            print(f"no write access to {path} ({kind}); install the udev rule", file=sys.stderr)
            status = 2
    return status


if __name__ == "__main__":
    sys.exit(main())
