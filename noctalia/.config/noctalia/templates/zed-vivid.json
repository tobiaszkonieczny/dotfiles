{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Noctalia Vivid",
  "author": "noctalia template",
  "themes": [
    {
      "name": "Noctalia Vivid",
      "appearance": "{{ mode }}",
      "style": {
        "background": "{{ colors.surface_container.default.hex }}",
        "surface.background": "{{ colors.surface_container_low.default.hex }}",
        "elevated_surface.background": "{{ colors.surface_container_high.default.hex }}",
        "panel.background": "{{ colors.surface_container_low.default.hex }}",
        "border": "{{ colors.outline_variant.default.hex }}",
        "border.variant": "{{ colors.outline_variant.default.hex }}",
        "border.focused": "{{ colors.primary.default.hex }}",
        "text": "{{ colors.on_surface.default.hex }}",
        "text.muted": "{{ colors.on_surface_variant.default.hex }}",
        "text.placeholder": "{{ colors.outline.default.hex }}",
        "text.accent": "{{ colors.primary.default.hex }}",
        "icon": "{{ colors.on_surface_variant.default.hex }}",
        "icon.accent": "{{ colors.primary.default.hex }}",
        "element.background": "{{ colors.surface_container_high.default.hex }}",
        "element.hover": "{{ colors.surface_container_highest.default.hex }}",
        "element.selected": "{{ colors.secondary_container.default.hex }}",
        "ghost_element.hover": "{{ colors.surface_container_high.default.hex }}",
        "ghost_element.selected": "{{ colors.secondary_container.default.hex }}",
        "title_bar.background": "{{ colors.surface_container.default.hex }}",
        "status_bar.background": "{{ colors.surface_container.default.hex }}",
        "tab_bar.background": "{{ colors.surface_container.default.hex }}",
        "tab.active_background": "{{ colors.surface.default.hex }}",
        "tab.inactive_background": "{{ colors.surface_container.default.hex }}",
        "toolbar.background": "{{ colors.surface.default.hex }}",
        "editor.background": "{{ colors.surface.default.hex }}",
        "editor.gutter.background": "{{ colors.surface.default.hex }}",
        "editor.foreground": "{{ colors.on_surface.default.hex }}",
        "editor.line_number": "{{ colors.outline.default.hex }}",
        "editor.active_line_number": "{{ colors.primary.default.hex }}",
        "editor.active_line.background": "{{ colors.surface_container_low.default.hex }}",
        "error": "{{ colors.error.default.hex }}",
        "warning": "{{ colors.syn_yellow.default.hex }}",
        "success": "{{ colors.syn_green.default.hex }}",
        "info": "{{ colors.syn_blue.default.hex }}",
        "hint": "{{ colors.on_surface_variant.default.hex }}",
        "created": "{{ colors.syn_green.default.hex }}",
        "modified": "{{ colors.syn_yellow.default.hex }}",
        "deleted": "{{ colors.syn_red.default.hex }}",
        "players": [
          {
            "cursor": "{{ colors.primary.default.hex }}",
            "background": "{{ colors.primary.default.hex }}",
            "selection": "{{ colors.primary_container.default.hex }}"
          }
        ],
        "syntax": {
          "comment": { "color": "{{ colors.outline.default.hex }}", "font_style": "italic" },
          "comment.doc": { "color": "{{ colors.on_surface_variant.default.hex }}", "font_style": "italic" },
          "keyword": { "color": "{{ colors.syn_purple.default.hex }}" },
          "function": { "color": "{{ colors.syn_blue.default.hex }}" },
          "type": { "color": "{{ colors.syn_yellow.default.hex }}" },
          "constructor": { "color": "{{ colors.syn_yellow.default.hex }}" },
          "string": { "color": "{{ colors.syn_green.default.hex }}" },
          "string.escape": { "color": "{{ colors.syn_cyan.default.hex }}" },
          "string.regex": { "color": "{{ colors.syn_cyan.default.hex }}" },
          "number": { "color": "{{ colors.syn_orange.default.hex }}" },
          "boolean": { "color": "{{ colors.syn_orange.default.hex }}" },
          "constant": { "color": "{{ colors.syn_orange.default.hex }}" },
          "enum": { "color": "{{ colors.syn_orange.default.hex }}" },
          "variant": { "color": "{{ colors.syn_orange.default.hex }}" },
          "variable": { "color": "{{ colors.on_surface.default.hex }}" },
          "variable.special": { "color": "{{ colors.syn_red.default.hex }}" },
          "property": { "color": "{{ colors.syn_cyan.default.hex }}" },
          "attribute": { "color": "{{ colors.syn_yellow.default.hex }}" },
          "tag": { "color": "{{ colors.syn_red.default.hex }}" },
          "operator": { "color": "{{ colors.syn_cyan.default.hex }}" },
          "punctuation": { "color": "{{ colors.on_surface_variant.default.hex }}" },
          "punctuation.bracket": { "color": "{{ colors.on_surface_variant.default.hex }}" },
          "label": { "color": "{{ colors.syn_pink.default.hex }}" },
          "preproc": { "color": "{{ colors.syn_pink.default.hex }}" },
          "title": { "color": "{{ colors.syn_blue.default.hex }}", "font_weight": 700 },
          "emphasis": { "font_style": "italic" },
          "emphasis.strong": { "font_weight": 700 },
          "link_uri": { "color": "{{ colors.syn_cyan.default.hex }}" }
        }
      }
    }
  ]
}
